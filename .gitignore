# Build outputs
bin/
obj/

# Auto-incrementing development build counter (NewRacingSystem.csproj, GenerateBuildNumber).
# Gitignored so that building never dirties the tree; CI supplies its own number instead.
build/build-number.txt

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# VS Code
.vscode/
*.code-workspace

# Other AI / editor harnesses
.clineignore
.context/
.continue/
.dsh/
# GitHub Actions workflows are version-controlled
.github/*
!.github/workflows/

# GTA runtime logs
ScriptHookV.log

# Runtime output that must never be committed or shipped (RefreshDist excludes these from the
# Dist mirror, and deploy.yml ships Dist - so this is the second line of defence, not the first)
*.log
pidump.txt
*.bak-crash

# OS files
Thumbs.db
.DS_Store

# Utility / junk folder
Util/

# Dist mirror: keep only the data (ini/xml/docs), not the built binaries
Dist/**/*.dll

# A roster the game rewrites is session data, not shipped content. RefreshDist mirrors the live install
# back into Dist, so this pool would dirty the tree after every run and deploy.yml would ship it with
# the release. It stays on disk in both places; only its place in the repo goes.
Dist/AutosportRacingSystem/Vehicles/tests.txt

# Imported python tooling leaves bytecode behind (docs/check-settings-keys.py is imported by its own self-test)
__pycache__/
# A GitHub API response somebody downloaded once; regenerated on demand, never source.
release-latest.json
