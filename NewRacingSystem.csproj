  <PropertyGroup>
    <GtaScriptsRoot Condition="'$(GtaScriptsRoot)' == ''">D:\SteamLibrary\steamapps\common\Grand Theft Auto V\Scripts</GtaScriptsRoot>
    <GtaArsScriptsDir>$(GtaScriptsRoot)\AutosportRacingSystem</GtaArsScriptsDir>
    <!-- Auto-incrementing development build counter, persisted between builds. It is no longer shipped as a file:
         the number reaches the binary as AssemblyFileVersion ("0.9.0.<n>") and the banner reads it back from the
         assembly, so the two can never disagree. -->
    <BuildNumberFile>$(MSBuildProjectDirectory)\build\build-number.txt</BuildNumberFile>
    <PostBuildEvent>if exist "$(GtaScriptsRoot)" (if not exist "$(GtaArsScriptsDir)" mkdir "$(GtaArsScriptsDir)" &amp; copy /Y "$(TargetPath)" "$(GtaArsScriptsDir)" &gt;nul)</PostBuildEvent>
  </PropertyGroup>
  <Target Name="CopyArsDll" AfterTargets="Build" Condition="Exists('$(GtaScriptsRoot)')">
    <MakeDir Directories="$(GtaArsScriptsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GtaArsScriptsDir)" />
    <Copy SourceFiles="$(TargetDir)LemonUI.SHVDN2.dll" DestinationFolder="$(GtaArsScriptsDir)" Condition="Exists('$(TargetDir)LemonUI.SHVDN2.dll')" />
  </Target>
  <!-- Mirror the live install into Dist\AutosportRacingSystem (the version-controlled, ship-ready
       set). Excludes runtime cruft: zip, log, and crash-backup files. Settings is excluded as a whole:
       the release ships the folder EMPTY and the mod fills it on first run, so a refresh must never
       copy the developer's session values in (they would be the shipped defaults otherwise). -->
  <!-- The Dist tree mirrors what is installed, so it must not carry the driver's scratch files: back-ups (*.bak) and the
         Tracks\testing folder are excluded by name. The published zip comes from a fresh CI checkout, which holds tracked
         files only - this mirror exists so a local pack cannot ship more than the install holds. -->
  <Target Name="RefreshDist" AfterTargets="Build" Condition="Exists('$(GtaArsScriptsDir)')">
    <MakeDir Directories="$(MSBuildProjectDirectory)\Dist\AutosportRacingSystem" />
    <Exec Command="robocopy &quot;$(GtaArsScriptsDir)&quot; &quot;$(MSBuildProjectDirectory)\Dist\AutosportRacingSystem&quot; /E /XD &quot;$(GtaArsScriptsDir)\Settings&quot; &quot;$(GtaArsScriptsDir)\Tracks\testing&quot; /XF *.zip *.log *.bak *.bak-crash pidump.txt build-number.txt /NFL /NDL /NJH /NJS" IgnoreExitCode="true" />
  </Target>
  <!-- Development build counter. This is deliberately NOT the assembly version: 0.8.6.0 in
       src\Properties\AssemblyInfo.cs is the release identity and only moves by hand. The counter is a
       separate, auto-incrementing identity that the init banner reports, so two builds of one release
       version are still told apart. It lives in build\ (gitignored, and excluded from the Dist mirror)
       so a build never dirties the tree. CI passes its own via -p:BuildNumber, because a fresh checkout
       would otherwise restart at 1 on every run.
       Inputs/Outputs is what makes the number describe the binary rather than the invocation: MSBuild
       skips this target when no source is newer than the counter, which is exactly when CoreCompile is
       skipped too, so the number can never tick ahead of the DLL it labels. Deleting build\ resets it. -->
  <Target Name="GenerateBuildNumber" BeforeTargets="CoreCompile"
          Inputs="@(Compile);$(MSBuildProjectFullPath)" Outputs="$(BuildNumberFile)"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(_BuildNumberGenerated)' != 'true'">
    <MakeDir Directories="$(MSBuildProjectDirectory)\build" />
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="'$(BuildNumber)' == '' AND Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" ItemName="_StoredBuildNumber" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <!-- An item list cannot be passed straight into a property function, so bind it to a property
           first. A truncated or hand-edited counter must not break the build: take the digits, else 0. -->
      <_StoredBuildNumberText>@(_StoredBuildNumber)</_StoredBuildNumberText>
    </PropertyGroup>
    <PropertyGroup>
      <_StoredBuildNumberDigits>$([System.Text.RegularExpressions.Regex]::Match($(_StoredBuildNumberText), '[0-9]+').Value)</_StoredBuildNumberDigits>
      <_StoredBuildNumberValue Condition="'$(_StoredBuildNumberDigits)' == ''">0</_StoredBuildNumberValue>
      <_StoredBuildNumberValue Condition="'$(_StoredBuildNumberDigits)' != ''">$(_StoredBuildNumberDigits)</_StoredBuildNumberValue>
      <BuildNumber Condition="'$(BuildNumber)' == '' AND '$(_StoredBuildNumberDigits)' != ''">$([MSBuild]::Add($(_StoredBuildNumberValue), 1))</BuildNumber>
      <_BuildNumberGenerated>true</_BuildNumberGenerated>
    </PropertyGroup>

    <!-- The file always holds the number this build used, including one passed in from CI, so the
         sidecar copied beside the DLL can never disagree with the banner. -->
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" />
  </Target>
  <!-- The build number belongs to the binary, not to a file beside it. This writes one attribute into obj\ and
       compiles it in: AssemblyFileVersion becomes 0.9.0.<build>, which also makes the number visible in the file's
       Windows properties. AssemblyVersion is untouched - that is the release identity and moves by hand.

       GenerateBuildNumber is skipped when the sources are unchanged, and a skipped target sets no properties, so
       the value is re-read from the counter file in that case: the attribute then matches the DLL already on disk. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" PropertyName="_BuildInfoFileValue" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_BuildInfoText Condition="'$(_BuildInfoFileValue)' != ''">$(_BuildInfoFileValue)</_BuildInfoText>
      <_BuildInfoText Condition="'$(_BuildInfoText)' == ''">$(BuildNumber)</_BuildInfoText>
      <_BuildInfoDigits>$([System.Text.RegularExpressions.Regex]::Match('$(_BuildInfoText)', '[0-9]+').Value)</_BuildInfoDigits>
      <_BuildInfoValue>$(_BuildInfoDigits)</_BuildInfoValue>
    </PropertyGroup>
    <!-- A failed read used to fall back to 0 and then, one target later, to a fabricated 1 - which shipped as
         AssemblyFileVersion 0.9.0.1 while the counter said 1287. Missing digits now stop the build. -->
    <Error Condition="'$(_BuildInfoValue)' == ''" Text="No build number: $(BuildNumberFile) held no digits and no BuildNumber property was passed, so the assembly would carry a version that is not a build." />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\obj\BuildInfo.g.cs"
                      Lines="[assembly: System.Reflection.AssemblyFileVersion(&quot;0.9.0.$(_BuildInfoValue)&quot;)]"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(MSBuildProjectDirectory)\obj\BuildInfo.g.cs" />
    </ItemGroup>
  </Target>
  <!-- The declared key set and the keys the code actually reads must agree; the checker fails the build when they do not. -->
  <Target Name="CheckSettingsKeys" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\docs\check-settings-keys.py&quot;" />
